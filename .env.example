# ==============================================================================
# Engine 2 (Logic & Rule) - Environment Variables Template
# ==============================================================================
# Port for the Engine 2 REST API HTTP Server
PORT=5000

# Engine 1 Database Integration (tourist_db1)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tourist_db1

# Security & Write Operations
# Public write routes are disabled by default.
# To enable administrative updates via x-admin-key header, set a secure key below.
ADMIN_API_KEY=
